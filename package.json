{
  "name": "lingshu-app",
  "version": "1.3.0",
  "description": "灵枢 - AI 路由与知识中枢",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem PORT=3005 node server-v2.js",
    "dev:api": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem PORT=3005 node server-v2.js",
    "electron:dev": "NODE_ENV=development electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.1",
    "@uiw/react-codemirror": "^4.25.11",
    "antd": "^5.12.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.0",
    "express": "^4.18.0",
    "markdown-it": "^14.3.0",
    "multer": "^2.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.lingshu.app",
    "productName": "灵枢",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "server-v2.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "灵枢需要使用麦克风录制会议音频并生成会议纪要。"
      },
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
